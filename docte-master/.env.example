# 后台接口基础地址
# 复制为 .env.local 后按联调环境修改；不配置时默认使用 utils/request.js 里的线上地址。
VITE_API_BASE_URL=https://api.cisco-d.com/api/v1

# 微信支付配置写在 uniCloud 云函数环境变量中，不要写入前端 .env.local。
# cicada-client-order 需要配置：
# WX_APPID=wx25289fbe4a3bf011
# WX_SECRET=请在 uniCloud 环境变量中配置，不要提交到仓库
# WX_PAY_APPID=wx25289fbe4a3bf011
# WX_PAY_MCH_ID=商户号
# WX_PAY_SERIAL_NO=商户 API 证书序列号
# WX_PAY_NOTIFY_URL=https://env-00jy6g4qwi94.dev-hz.cloudbasefunction.cn/cicada-client-order/wechatPayNotify
# WX_PAY_PRIVATE_KEY_BASE64=商户 API 私钥 base64 后的内容
# uniCloud 单值超过 1024 字符时，改为连续配置 WX_PAY_PRIVATE_KEY_BASE64_1、_2、_3
# WX_PAY_API_V3_KEY=微信支付 APIv3 密钥，32字节
# WX_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_0117477337352026072200382178004605
# WX_PAY_PUBLIC_KEY_BASE64=微信支付公钥 PEM 文件 base64 后的内容（不是商户私钥）
# 公钥单值超过 1024 字符时，同样可连续配置 WX_PAY_PUBLIC_KEY_BASE64_1、_2、_3

# 快递100配置写在 uniCloud 服务空间全局环境变量中，不要写入前端环境文件：
# EXPRESS_PROVIDER=kuaidi100
# KUAIDI100_KEY=企业版授权Key
# KUAIDI100_CUSTOMER=企业版customer授权码
# KUAIDI100_CALLBACK_URL=https://云函数URL化地址/cicada-express-callback/notify
# KUAIDI100_CALLBACK_SALT=自行生成的高强度随机字符串

# 订阅消息模板 ID 写在 uniCloud 服务空间全局环境变量中，供 client-public、
# client-order、admin-order 三个云函数读取；这里仅列出变量名和当前生产 ID。

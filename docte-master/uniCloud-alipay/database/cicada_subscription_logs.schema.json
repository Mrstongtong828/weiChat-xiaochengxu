{
  "bsonType": "object",
  "required": [
    "scene",
    "status",
    "create_time"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID"
    },
    "order_id": {
      "bsonType": "string"
    },
    "order_no": {
      "bsonType": "string"
    },
    "user_id": {
      "bsonType": "string"
    },
    "openid": {
      "bsonType": "string"
    },
    "scene": {
      "bsonType": "string",
      "enum": [
        "repair_submitted",
        "order_received",
        "quote_issued",
        "payment_confirmed",
        "payment_rejected",
        "order_shipped",
        "order_completed",
        "process_tip"
      ]
    },
    "dedupe_key": {
      "bsonType": "string",
      "description": "业务通知幂等键；同一键已有 sent 日志时跳过重复发送"
    },
    "template_id": {
      "bsonType": "string"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ]
    },
    "fail_reason": {
      "bsonType": "string"
    },
    "create_time": {
      "bsonType": "timestamp"
    }
  }
}

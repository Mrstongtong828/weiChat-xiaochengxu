    },
    "coverage_note": {
      "bsonType": "string",
      "description": "工程师质保核验备注"
    },
    "fault_desc": {
      "bsonType": "string"
    },
    "media_urls": {
      "bsonType": "array"
    },
    "voucher_urls": {
      "bsonType": "array",
      "description": "购买凭证图片列表"
    },
    "image_urls": {
      "bsonType": "array",
      "description": "故障图片列表"
    },
    "video_urls": {
      "bsonType": "array",
      "description": "故障视频列表"
    },
    "fix_solution": {
      "bsonType": "string"
    }

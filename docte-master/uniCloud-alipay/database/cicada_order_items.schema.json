{
  "bsonType": "object",
  "required": [
    "order_id",
    "product_name"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID"
    },
    "order_id": {
      "bsonType": "string"
    },
    "product_name": {
      "bsonType": "string"
    },
    "product_model": {
      "bsonType": "string"
    },
    "sn": {
      "bsonType": "string"
    },
    "sn_normalized": {
      "bsonType": "string",
      "description": "SN 规范化键（大写、去空格/横杠），用于容错检索匹配"
    },
    "product_category": {
      "bsonType": "string",
      "description": "设备分类（后台回填）"
    },
    "buy_date": {
      "bsonType": "string"
    },
    "warranty_months": {
      "bsonType": "int",
      "description": "可选质保月数；仅在明确填写时参与质保推算"
    },
    "warranty_expire": {
      "bsonType": "string",
      "description": "可选质保截止日 YYYY-MM-DD；填写时优先于月数推算"
